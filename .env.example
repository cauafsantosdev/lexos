# Development MinIO server credentials
# S3-Compatible Object Storage
# MinIO backs development; S3_* variables can target Cloudflare R2 in production.
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=admin12345

# S3-compatible storage client configuration
# MinIO is used in development. Cloudflare R2 uses the same variables in production.
S3_ENDPOINT=lexos-minio:9000
S3_ACCESS_KEY=admin
S3_SECRET_KEY=admin12345
S3_BUCKET=lexos-storage
S3_USE_SSL=false
S3_REGION=
S3_AUTO_CREATE_BUCKET=false

# Processing cache and task retention
CACHE_TTL_SECONDS=604800
TASK_TTL_SECONDS=86400
PROCESSING_LOCK_TTL_SECONDS=3600

# Hugging Face configuration
HF_TOKEN=your_huggingface_token_here

# Redis configuration
REDIS_URL=redis:6379

# Frontend configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_GITHUB_URL=https://github.com/cauafsantosdev/lexos