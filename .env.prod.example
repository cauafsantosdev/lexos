# Replace the hostname with the Redis network alias used in the Docker Compose production network.
REDIS_URL=redis://<REDIS_NETWORK_ALIAS>:6379/1

# Cloudflare R2 production endpoint.
S3_ENDPOINT=https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ACCESS_KEY=<R2_ACCESS_KEY_ID>
S3_SECRET_KEY=<R2_SECRET_ACCESS_KEY>
S3_BUCKET=lexos-prod
S3_USE_SSL=true
S3_REGION=auto

# Production buckets are provisioned externally.
S3_AUTO_CREATE_BUCKET=false

# Reusable processing metadata: 7 days.
CACHE_TTL_SECONDS=604800

# Public task state: 24 hours.
TASK_TTL_SECONDS=86400

# Maximum ownership lease for an in-flight processing fingerprint.
PROCESSING_LOCK_TTL_SECONDS=3600

OMP_NUM_THREADS=2

# Persistent model cache mounted from /opt/apps/lexos/models.
HF_HOME=/models
FASTEMBED_CACHE_PATH=/models/fastembed

# Keep empty unless a Hugging Face token is required by a future model or download policy.
HF_TOKEN=

CORS_ALLOWED_ORIGINS=https://lexos.cauafsantos.dev
TRUST_PROXY=true
MAX_REQUEST_BODY_SIZE=50M